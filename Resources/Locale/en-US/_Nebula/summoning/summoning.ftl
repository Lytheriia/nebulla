trait-summonable-name = Summonable
trait-summonable-desc = You can be summoned with a cursed chalk.

summon-chalk-popup-no-magic = Unfortunately, magic does not work here.
summon-chalk-popup-bad-tile = The rune can only be drawn on a free floor.
summon-chalk-popup-occupied = There is already a rune here.
