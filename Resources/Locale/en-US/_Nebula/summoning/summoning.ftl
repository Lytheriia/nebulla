summon-refusal-text = [italic]You can hear at the edge of your hearing: "{ $text }"[/italic]
summon-refusal-silent = [italic]It refuses to answer![/italic]

summon-return-window-title = Attempt to return?
summon-return-window-text = Do you want to attempt to return?

summon-popup-summoned = You have been summoned!

summon-window-yes = Yes
summon-window-no = No
summon-window-ok = OK
summon-window-cancel = Cancel

summon-gender-male = Male
summon-gender-female = Female
summon-gender-epicene = Person
summon-gender-neuter = Thing
summon-candidate-label = { $gender } | { $species } | { $name }

summon-chant-1 = O magne Asmodee! Quaeso inducere unus ex satellitibus tuis ad me!
summon-chant-2 = Coniuro te, daemon luxuriae! Utinam unus ex satellitibus tuis mea vota persolvat!
summon-chant-3 = Cupidus meus ardet, magne! Amor unus ex satellitibus tuis me moveat affectus!
