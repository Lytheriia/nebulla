cmd-align-desc =
    Автоматически поворачивает все закреплённые шлюзы, двери, пожарные шлюзы и т.п.
    так, чтобы они совпадали с соседними структурами.

    Параметр [пробный прогон] выполняет проверку, ничего не поворачивая.
cmd-align-help = Использование: {$command} [MapID] [пробный прогон?]
cmd-align-hint-id = MapID
cmd-align-hint-dry = пробный прогон?
cmd-align-feedback-none = {$dry ->
[true] ПРОБНЫЙ ПРОГОН: Не
*[false] Не
} найдено сущностей, совместимых с AlignerSystem!
cmd-align-feedback-good = {$dry ->
[true] ПРОБНЫЙ ПРОГОН: Не
*[false] Не
} найдено неправильно повёрнутых сущностей.
cmd-align-feedback = {$dry ->
[true] ПРОБНЫЙ ПРОГОН: Найдено
*[false] Найдено и исправлено
} {$fixed ->
[one] {$fixed} неправильно повёрнутая сущность.
[few] {$fixed} неправильно повёрнутые сущности.
*[other] {$fixed} неправильно повёрнутых сущностей.
}
