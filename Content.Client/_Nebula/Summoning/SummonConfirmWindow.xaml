<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="360 130">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <RichTextLabel Name="TextLabel" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="AcceptButton"
                    Text="{Loc summon-window-yes}"
                    StyleClasses="positive"
                    Disabled="True"
                    HorizontalExpand="True" />
            <Button Name="DenyButton"
                    Text="{Loc summon-window-no}"
                    Disabled="True"
                    HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
