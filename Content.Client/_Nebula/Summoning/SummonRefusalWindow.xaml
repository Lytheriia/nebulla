<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc summon-refusal-window-title}"
                      MinSize="360 120">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <Label Text="{Loc summon-refusal-window-text}" />
        <LineEdit Name="ReasonEdit" HorizontalExpand="True" />
        <Button Name="SendButton"
                Text="{Loc summon-refusal-window-send}"
                HorizontalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
