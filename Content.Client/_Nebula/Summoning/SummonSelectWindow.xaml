<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc summon-select-window-title}"
                      MinSize="360 300"
                      SetSize="400 340">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <Label Text="{Loc summon-select-window-text}" />
        <ItemList Name="Candidates" SelectMode="Single" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="OkButton"
                    Text="{Loc summon-window-ok}"
                    StyleClasses="positive"
                    Disabled="True"
                    HorizontalExpand="True" />
            <Button Name="CancelButton"
                    Text="{Loc summon-window-cancel}"
                    HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
